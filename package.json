{
  "name": "crishub-meta-mcp-workspace",
  "private": true,
  "version": "0.1.0-dev",
  "description": "CRISHUB Meta MCP Toolkit workspace (independent, not affiliated with Meta)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-stdio.mjs",
    "example:sdk": "node examples/sdk/list-pages.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
