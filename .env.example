# Copy to .env (git-ignored) only for local live testing with an owned test app.
# Mock mode needs none of these.
META_MODE=mock
# META_ACCESS_TOKEN=
# META_TOKEN_TYPE=user            # user | system_user
# META_APP_ID=
# META_APP_SECRET=                # enables appsecret_proof
# META_GRAPH_VERSION=v26.0        # v25.0 | v26.0
# META_ADAPTERS=facebook,marketing
# META_ALLOWED_PAGE_IDS=          # optional comma-separated allowlist
# META_ALLOWED_AD_ACCOUNT_IDS=
# META_ALLOWED_BUSINESS_IDS=
# META_ENABLE_UNVERIFIED_TOOLS=false
# META_MOCK_SCENARIO=default      # default | expired_token | rate_limited | permission_denied | review_required | upstream_flaky | malformed_response
# META_TIMEOUT_MS=10000
# META_LOG_LEVEL=info
